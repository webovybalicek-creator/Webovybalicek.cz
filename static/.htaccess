ErrorDocument 404 /404.html

# osobní dashboard /design/ – nikdy neindexovat (i kdyby na něj vedl odkaz)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/design#">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
</IfModule>

# stránka Reference byla zrušena – vybrané projekty jsou na úvodní stránce
RewriteEngine On

# jedna adresa: https bez www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^reference(/.*)?$ /#projekty [R=301,L,NE]

# blog byl zrušen
RewriteRule ^(blog|4-tipy-jak-vydelavat-blogem|5-efektivnich-tipu-jak-zvysit-navstevnost-webu)/?$ / [R=301,L]

# staré archivy WordPressu
RewriteRule ^category/ / [R=301,L]
RewriteRule ^(author|tag)/ / [R=301,L]

# rychlost: komprese textových souborů
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# rychlost: cache v prohlížeči. CSS, JS a obrázky mají v odkazu ?v=VERZE, po deployi se načtou znovu.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  # CSS a JS se vždy odkazují s ?v=VERZE – můžou být „navždy“
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # obrázky a písma někde bez ?v= – 30 dní, ať se případná výměna projeví
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
